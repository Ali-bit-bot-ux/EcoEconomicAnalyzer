# Daryn — .gitignore

# Виртуальное окружение
.venv/
venv/
env/

# Кэш GEE и сырые данные (большие файлы)
data/raw/
*.gpickle
*.pkl

# Разрешаем предрассчитанные результаты анализа для облачного дашборда (< 1 MB)
!data/processed/*.parquet
!data/processed/*.json
!data/processed/*.gpickle

# Логи
logs/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Секреты (никогда не коммитить!)
.env
*.key
*credentials*

# IDE
.vscode/
.idea/
*.swp

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit кэш
.streamlit/

# Тесты
.pytest_cache/
htmlcov/
